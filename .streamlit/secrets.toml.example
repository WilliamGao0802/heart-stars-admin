# 心与星寻 · Streamlit Secrets 示例
#
# 用法：
#   本地 → 复制成 .streamlit/secrets.toml（已被 .gitignore 排除，不会上传）
#   云端 → 在 Streamlit Cloud 的 App 设置里选 Secrets，把下面内容粘进去
#
# ⚠️ 上线前务必把 email / password / db_key 全部换成你自己的强口令。
#     db_key 改完必须同步更新数据库函数里的密钥（见《Streamlit发布操作步骤.md》第 5 节）。

[admin]
# 管理后台登录用（浏览器里输入的就是这两个）
email = "your-name@example.com"
password = "换成一个强密码"

# 后台读数据库用的密钥（必须与数据库函数里的字面量一致）
db_key = "gld20080802"
